{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofguard.local/schemas/loan-policy-v1.json",
  "title": "ProofGuard Loan Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "compiler",
    "policyId",
    "policyVersion",
    "predecessor",
    "source",
    "destination",
    "constraints",
    "rulesHash",
    "rules"
  ],
  "properties": {
    "schema": { "const": "proofguard.loan-policy/v1" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "proofguard-loan-policy-compiler/v1" },
        "version": { "$ref": "#/$defs/bytes32" }
      }
    },
    "policyId": { "$ref": "#/$defs/bytes32" },
    "policyVersion": { "$ref": "#/$defs/uintString" },
    "predecessor": { "$ref": "#/$defs/bytes32" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainKey", "evmChainId", "contract", "codeHash", "owner", "startBlock"],
      "properties": {
        "chainKey": { "$ref": "#/$defs/uintString" },
        "evmChainId": { "$ref": "#/$defs/uintString" },
        "contract": { "$ref": "#/$defs/address" },
        "codeHash": { "$ref": "#/$defs/bytes32" },
        "owner": { "$ref": "#/$defs/address" },
        "startBlock": { "$ref": "#/$defs/uintString" }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "action"],
      "properties": {
        "application": { "$ref": "#/$defs/address" },
        "action": { "const": "RELEASE_TCTC_LOAN" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxCoverageAgeBlocks", "loanRatioBps", "minPrincipal", "maxPrincipal"],
      "properties": {
        "maxCoverageAgeBlocks": { "$ref": "#/$defs/uintString" },
        "loanRatioBps": { "$ref": "#/$defs/uintString" },
        "minPrincipal": { "$ref": "#/$defs/uintString" },
        "maxPrincipal": { "$ref": "#/$defs/uintString" }
      }
    },
    "rulesHash": { "$ref": "#/$defs/bytes32" },
    "rules": { "type": "object" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "uintString": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
