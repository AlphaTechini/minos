# Ethereum Sepolia JSON-RPC endpoint used to discover position events.
SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Creditcoin CC3 Testnet JSON-RPC endpoint used to submit proven events.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# CC3 Testnet EVM chain ID, documented for reference.
CREDITCOIN_EVM_CHAIN_ID=102031

# Creditcoin CC3 Testnet Proof Builder endpoint.
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/

# Creditcoin's runtime source identifier for Ethereum Sepolia. Confirm it at runtime before deployment.
SOURCE_CHAIN_KEY=1

# Deployed contract addresses.
SOURCE_POSITION_CONTRACT_ADDRESS=
PROOF_GUARD_CONTRACT_ADDRESS=

# Private key for the worker's Creditcoin transaction signer. Never commit a real value.
CREDITCOIN_WORKER_PRIVATE_KEY=

# Deployment-only values used by the PowerShell commands in README.md.
SOURCE_DEPLOYER_PRIVATE_KEY=
SOURCE_OWNER_ADDRESS=
CREDITCOIN_DEPLOYER_PRIVATE_KEY=
WORKER_ADDRESS=
DECODER_LIBRARY_ADDRESS=

# The Sepolia deployment block of SOURCE_POSITION_CONTRACT_ADDRESS.
WORKER_START_BLOCK=

# Worker polling behavior.
WORKER_POLL_INTERVAL_MS=15000
WORKER_BLOCK_BATCH_SIZE=250
